{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Cashew Persistent FADA Luna Semantic Decision v4",
  "description": "Only semantic choices are produced by Luna. Python derives request binding, parameters_after, changed_parameters, and Planet bookkeeping.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "action",
    "continue_training",
    "selected_epoch",
    "reason_codes",
    "analysis_summary",
    "previous_hypothesis_review",
    "current_state_assessment",
    "intervention",
    "experiment",
    "next_stage_expectation"
  ],
  "properties": {
    "action": {
      "type": "string",
      "enum": [
        "ADJUST",
        "KEEP",
        "PAUSE_ADV",
        "RESUME_ADV",
        "CONTINUE",
        "STOP",
        "SELECT_CHECKPOINT",
        "REQUEST_EXPERIMENT"
      ]
    },
    "continue_training": {
      "type": "boolean"
    },
    "selected_epoch": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 200
    },
    "reason_codes": {
      "type": "array",
      "minItems": 0,
      "maxItems": 12,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120
      }
    },
    "analysis_summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "previous_hypothesis_review": {
      "$ref": "#/$defs/hypothesis_review"
    },
    "current_state_assessment": {
      "$ref": "#/$defs/state_assessment"
    },
    "intervention": {
      "$ref": "#/$defs/intervention"
    },
    "experiment": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/experiment"
        }
      ]
    },
    "next_stage_expectation": {
      "$ref": "#/$defs/next_stage_expectation"
    }
  },
  "$defs": {
    "hypothesis_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "summary",
        "evidence"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "supported",
            "partially_supported",
            "rejected",
            "not_applicable"
          ]
        },
        "summary": {
          "type": "string"
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "state_assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "summary",
        "evidence",
        "candidate_checkpoint_window",
        "candidate_window_rationale"
      ],
      "properties": {
        "state": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "candidate_checkpoint_window": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 200
          },
          "minItems": 1
        },
        "candidate_window_rationale": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "parameter_update": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parameter",
        "value"
      ],
      "properties": {
        "parameter": {
          "type": "string",
          "enum": [
            "lambda_adv",
            "main_lr",
            "D_lr",
            "D_steps_per_G_step",
            "temperature",
            "confidence_cap",
            "main_weight_decay",
            "D_weight_decay"
          ]
        },
        "value": {
          "type": "number"
        }
      }
    },
    "schedule_choice": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component",
        "curve"
      ],
      "properties": {
        "component": {
          "type": "string",
          "enum": [
            "main_lr",
            "D_lr",
            "lambda_adv"
          ]
        },
        "curve": {
          "type": "string",
          "enum": [
            "constant",
            "cosine",
            "poly",
            "dann_sigmoid"
          ]
        }
      }
    },
    "schedule_update": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component",
        "operation",
        "phase"
      ],
      "properties": {
        "component": {
          "type": "string",
          "enum": [
            "main_lr",
            "D_lr",
            "lambda_adv"
          ]
        },
        "operation": {
          "type": "string",
          "enum": [
            "hold",
            "resume",
            "set_phase",
            "set_phase_hold"
          ]
        },
        "phase": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "intervention": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "adversarial_state_after",
        "parameter_updates",
        "schedule_choices",
        "schedule_updates",
        "emergency",
        "rationale"
      ],
      "properties": {
        "adversarial_state_after": {
          "type": "string",
          "enum": [
            "active",
            "paused"
          ]
        },
        "parameter_updates": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/parameter_update"
          }
        },
        "schedule_choices": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/schedule_choice"
          }
        },
        "schedule_updates": {
          "type": "array",
          "maxItems": 1,
          "items": {
            "$ref": "#/$defs/schedule_update"
          }
        },
        "emergency": {
          "type": "boolean"
        },
        "rationale": {
          "type": "string"
        }
      }
    },
    "experiment": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "hypothesis",
            "parameter_updates",
            "adversarial_state_after",
            "steps",
            "expected_observation",
            "falsification"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "custom_code"
              ]
            },
            "hypothesis": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            },
            "parameter_updates": {
              "type": "array",
              "minItems": 0,
              "maxItems": 0,
              "items": {
                "$ref": "#/$defs/parameter_update"
              }
            },
            "adversarial_state_after": {
              "type": "string",
              "enum": [
                "active",
                "paused"
              ]
            },
            "steps": {
              "type": "integer",
              "enum": [
                32,
                64,
                128
              ]
            },
            "expected_observation": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            },
            "falsification": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "hypothesis",
            "parameter_updates",
            "adversarial_state_after",
            "steps",
            "expected_observation",
            "falsification"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "paired_training",
                "discriminator_probe"
              ]
            },
            "hypothesis": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            },
            "parameter_updates": {
              "type": "array",
              "minItems": 1,
              "maxItems": 1,
              "items": {
                "$ref": "#/$defs/parameter_update"
              }
            },
            "adversarial_state_after": {
              "type": "string",
              "enum": [
                "active",
                "paused"
              ]
            },
            "steps": {
              "type": "integer",
              "enum": [
                32,
                64,
                128
              ]
            },
            "expected_observation": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            },
            "falsification": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1000
            }
          }
        }
      ]
    },
    "next_stage_expectation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hypothesis",
        "expected_source",
        "expected_target",
        "expected_discriminator",
        "expected_gradient_ratio",
        "failure_triggers"
      ],
      "properties": {
        "hypothesis": {
          "type": "string"
        },
        "expected_source": {
          "type": "string"
        },
        "expected_target": {
          "type": "string"
        },
        "expected_discriminator": {
          "type": "string"
        },
        "expected_gradient_ratio": {
          "type": "string"
        },
        "failure_triggers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
